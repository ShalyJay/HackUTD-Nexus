# Copy to .env.local and fill in real values. Never commit .env.local.

# Google Gemini API key (https://ai.google.dev/)
VITE_GEMINI_API_KEY=

# Optional: used only by the Firebase seed script to create the demo admin account.
# Prefer setting a strong unique password; rotate if this repo was ever public.
VITE_ADMIN_EMAIL=admin@example.com
VITE_ADMIN_PASSWORD=
